                  "data-pendidikan/lulus-tepat-waktu",
                  "data-pendidikan/tugas-akhir"
                ]
              },
              {
                "group": "Lihat Data Penelitian",
                "icon": "angle-right",
                "pages": [
                  "data-penelitian/penelitian",
                  "data-penelitian/karya-ilmiah",
                  "data-penelitian/haki",
                  "data-penelitian/publikasi-jurnal"
                ]
              },
              {
                "group": "Lihat Data Pengabdian",
                "icon": "angle-right",
                "pages": [
                  "data-pengabdian/kegiatan-pkm",
                  "data-pengabdian/publikasi-pkm",
                  "data-pengabdian/bahan-ajar-pkm",
                  "data-pengabdian/mutu-pelaksanaan"
                ]
              },
              "essentials/navigation-copied-6",
              "essentials/navigation-copied-7"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
